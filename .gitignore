# =========================================================================
# Enterprise .gitignore - Apex Commercial Bank Zero-Trust Governor
# =========================================================================

# Python Virtual Environments
.venv/
venv/
env/
ENV/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.spec

# Pytest & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type Checking
.mypy_cache/
.pyre/
.pytype/

# SQLite & Ephemeral Local Databases
*.db
*.db-shm
*.db-wal
*.sqlite3

# Node & Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Secrets (Never commit secrets to git)
.env
.env.*
!.env.example

# Temporary Agent Scaffolding & Tool Scratchpads
.agents/
.agent/

# Operating System Artifacts
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor Directories
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Jupyter Notebooks
.ipynb_checkpoints/

# Version Managers
.python-version