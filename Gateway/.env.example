# ==============================================================================
# Agentic-AI Identity & Access Governor - Environment Configuration Template
# Copy to .env and modify as needed for your environment.
# ==============================================================================

# Application Settings
APP_NAME=Agentic-AI Identity & Access Governor
APP_VERSION=1.0.0
DOMAIN=BFSI Retail Banking
GATEWAY_PORT=8000

# Security & Cryptography
JWT_SECRET_KEY=deloitte-capstone-2026-secret-key-pes-university
JWT_ALGORITHM=HS256
TOKEN_EXPIRY_SECONDS=3600

# SLA & Latency Targets (Deloitte Rubric)
MAX_PEP_LATENCY_MS=5.0
MAX_KILLSWITCH_MTTR_MS=200.0
QUARANTINE_RISK_THRESHOLD=0.75

# PostgreSQL System of Record (Audit Logs, Conversations & Accounts)
POSTGRES_USER=governor_admin
POSTGRES_PASSWORD=deloitte_secure_pass
POSTGRES_DB=governance_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://governor_admin:deloitte_secure_pass@localhost:5432/governance_db

# Redis In-Memory Revocation Cache (<0.2ms sub-second killswitch)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PREFIX=agentic_iam:

# Apache Kafka Telemetry & Event Bus
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TELEMETRY=agentic-iam.telemetry
KAFKA_TOPIC_ALERTS=agentic-iam.alerts
KAFKA_GROUP_ID=agentic-iam-ml-risk-engine

# Database GUI Web Viewers
PGWEB_PORT=8081
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@deloitte.com
PGADMIN_DEFAULT_PASSWORD=deloitte_secure_pass
